'use client'

import { motion } from 'framer-motion'
import { ArrowRight } from 'lucide-react'

/**
 * Dark Luxury Motion — Hero example
 *
 * Demonstrerer retningens signaturmoves:
 * - Warm dark background med radial accent-glow
 * - Geist display font med fluid scale
 * - Scroll-triggered fade-up med stagger
 * - Glass-card med backdrop-blur
 * - Monospace "live" label med pulserende prikk
 * - Hover-state med scale + shadow-expand
 *
 * Bytt ut copy med kunde-spesifikk tekst, og overstyr
 * --color-accent-primary i tokens.css hvis annen farge.
 */

const fadeUp = {
  initial: { opacity: 0, y: 24 },
  animate: { opacity: 1, y: 0 },
  transition: { duration: 0.8, ease: [0.16, 1, 0.3, 1] },
}

const stagger = (i: number) => ({
  ...fadeUp,
  transition: { ...fadeUp.transition, delay: i * 0.1 },
})

export function Hero() {
  return (
    <section className="relative min-h-[100svh] overflow-hidden bg-bg">
      {/* Radial accent glow — signatur-move */}
      <div
        aria-hidden
        className="pointer-events-none absolute inset-0"
        style={{
          background:
            'radial-gradient(circle at 30% 20%, var(--color-accent-glow), transparent 60%)',
        }}
      />

      <div className="container-default relative mx-auto flex min-h-[100svh] flex-col justify-center px-6 py-section">
        {/* Mono label med live prikk */}
        <motion.div {...stagger(0)} className="mb-8 flex items-center gap-3">
          <span
            className="block h-2 w-2 rounded-full bg-success"
            style={{ animation: 'pulse 2s ease-in-out infinite' }}
            aria-hidden
          />
          <span className="font-mono text-xs uppercase tracking-mono text-text-mono">
            Live siden 2008
          </span>
        </motion.div>

        {/* Hero headline — fluid type */}
        <motion.h1
          {...stagger(1)}
          className="font-display text-hero font-medium leading-tight tracking-tight text-text-primary"
        >
          Frakt på Romerike <br />
          <span className="text-accent-primary">levert på 60 minutter.</span>
        </motion.h1>

        {/* Subhead */}
        <motion.p
          {...stagger(2)}
          className="mt-8 max-w-2xl text-lg leading-relaxed text-text-secondary"
        >
          Vi henter når du trenger det og leverer dit du sier — fra brev til
          32-tonner. Beregn pris på 30 sekunder.
        </motion.p>

        {/* CTA row */}
        <motion.div {...stagger(3)} className="mt-12 flex flex-wrap gap-4">
          <a
            href="/beregn-pris"
            className="
              group inline-flex items-center gap-2 rounded-lg
              bg-accent-primary px-7 py-4 text-base font-medium text-bg
              transition-all duration-fast ease-out-expo
              hover:scale-[1.02] hover:shadow-glow
              active:scale-[0.98]
              focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-primary focus-visible:ring-offset-2 focus-visible:ring-offset-bg
            "
          >
            Beregn pris
            <ArrowRight
              size={18}
              className="transition-transform duration-fast group-hover:translate-x-1"
            />
          </a>

          <a
            href="/kontakt"
            className="
              inline-flex items-center gap-2 rounded-lg
              border border-border-strong bg-surface-glass px-7 py-4
              text-base font-medium text-text-primary backdrop-blur-[var(--blur-glass)]
              transition-all duration-fast ease-out-expo
              hover:border-text-primary hover:bg-surface-1
              focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-text-primary
            "
          >
            Snakk med oss
          </a>
        </motion.div>

        {/* Stat-strip (signatur: glass-card med tall) */}
        <motion.div
          {...stagger(4)}
          className="mt-24 grid grid-cols-2 gap-6 md:grid-cols-4"
        >
          {[
            { value: '17 år', label: 'Siden vi startet' },
            { value: '24/7', label: 'Tilgjengelig' },
            { value: '< 60 min', label: 'Express-levering' },
            { value: '8 biler', label: 'I flåten' },
          ].map((stat) => (
            <div
              key={stat.label}
              className="
                rounded-xl border border-border-subtle
                bg-surface-glass p-6 backdrop-blur-[var(--blur-glass)]
                transition-all duration-normal ease-out-expo
                hover:-translate-y-1 hover:border-border-strong hover:shadow-card
              "
            >
              <div className="font-display text-2xl font-medium tracking-tight text-text-primary">
                {stat.value}
              </div>
              <div className="mt-1 font-mono text-2xs uppercase tracking-mono text-text-mono">
                {stat.label}
              </div>
            </div>
          ))}
        </motion.div>
      </div>

      <style jsx>{`
        @keyframes pulse {
          0%,
          100% {
            opacity: 1;
            transform: scale(1);
          }
          50% {
            opacity: 0.5;
            transform: scale(0.85);
          }
        }
      `}</style>
    </section>
  )
}
