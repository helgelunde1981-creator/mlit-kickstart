/**
 * Dark Luxury Motion — Framer Motion vokabular
 *
 * Gjenbrukbare variants og transitions for direktion-en.
 * Hold seg innenfor `--ease-out-expo` og `--duration-normal` for konsistens.
 */

import type { Variants } from 'framer-motion'

// ── Easings (matcher tokens.css) ─────────────────────────────────────
export const EASE_OUT_EXPO = [0.16, 1, 0.3, 1] as const
export const EASE_OUT_BACK = [0.34, 1.56, 0.64, 1] as const
export const EASE_IN_OUT = [0.65, 0, 0.35, 1] as const

// ── Durations (sekunder) ─────────────────────────────────────────────
export const DUR_FAST = 0.15
export const DUR_NORMAL = 0.3
export const DUR_SLOW = 0.5
export const DUR_SLOWER = 0.8

// ── Common variants ──────────────────────────────────────────────────

/** Fade + lift up, brukes på hero-elementer */
export const fadeUp: Variants = {
  hidden: { opacity: 0, y: 24 },
  show: { opacity: 1, y: 0, transition: { duration: DUR_SLOWER, ease: EASE_OUT_EXPO } },
}

/** Fade + lift, mindre amplitude, for cards inn i viewport */
export const fadeUpSmall: Variants = {
  hidden: { opacity: 0, y: 16 },
  show: { opacity: 1, y: 0, transition: { duration: DUR_SLOW, ease: EASE_OUT_EXPO } },
}

/** Fade fra side, for sticky / sidebar */
export const fadeRight: Variants = {
  hidden: { opacity: 0, x: -32 },
  show: { opacity: 1, x: 0, transition: { duration: DUR_SLOWER, ease: EASE_OUT_EXPO } },
}

/** Container med stagger — brukes på lister/grids */
export const stagger: Variants = {
  hidden: {},
  show: {
    transition: { staggerChildren: 0.08, delayChildren: 0.1 },
  },
}

/** Scale-in for popovers, tooltips, dialoger */
export const scaleIn: Variants = {
  hidden: { opacity: 0, scale: 0.95 },
  show: { opacity: 1, scale: 1, transition: { duration: DUR_NORMAL, ease: EASE_OUT_BACK } },
  exit: { opacity: 0, scale: 0.95, transition: { duration: DUR_FAST } },
}

/** Slide-up for bottom-sheets, mobile drawers */
export const slideUp: Variants = {
  hidden: { y: '100%' },
  show: { y: 0, transition: { duration: DUR_SLOW, ease: EASE_OUT_EXPO } },
  exit: { y: '100%', transition: { duration: DUR_NORMAL, ease: EASE_IN_OUT } },
}

// ── Patterns ─────────────────────────────────────────────────────────

/** Hover på cards: lift + shadow expand (kombineres med CSS) */
export const cardHover = {
  rest: { y: 0 },
  hover: { y: -4, transition: { duration: DUR_NORMAL, ease: EASE_OUT_EXPO } },
}

/** Button-pressed micro-animation */
export const buttonPress = {
  whileHover: { scale: 1.02 },
  whileTap: { scale: 0.98 },
  transition: { duration: DUR_FAST, ease: EASE_OUT_EXPO },
}

// ── Scroll-trigger defaults ──────────────────────────────────────────

/** Standard viewport-config for whileInView */
export const viewportOnce = {
  once: true,
  margin: '-100px',
}

export const viewportRepeat = {
  once: false,
  margin: '-20%',
}

// ── Reduced-motion-respect ───────────────────────────────────────────

/**
 * Bruk denne i komponenter for å skru av motion ved prefers-reduced-motion.
 * Framer Motion sin MotionConfig kan settes globalt i root layout.
 */
export const reducedMotionConfig = {
  // I _app.tsx eller layout.tsx:
  // <MotionConfig reducedMotion="user">{children}</MotionConfig>
} as const
