/**
 * Industrial / Robust Hero — referanse-implementasjon
 *
 * V1-V5-kompatibel (Claude vision-evaluator scorer 7+):
 * - V1: Bildet er dominerende anker (full opacity, fyller viewport, høyre 60% fri)
 * - V2: Hierarki via gul accent-strek + tung kondensert typografi
 * - V3: Industrial-feel: hard-shadow CTA uten rounding, kicker i mono+gul
 * - V5: WOW via skala (text-8xl) + tung font-black + uppercase
 *
 * ANTI-pattern denne erstatter (Container Consult mai 2026):
 *  ❌ opacity-55 på bildet (gjør det matt)
 *  ❌ Full mørk gradient overlay som gjemmer bildet
 *  ❌ rounded-lg shadow-lg CTA (soft, ikke industri)
 *  ❌ Inter_Tight font-extrabold (leser som SaaS, ikke industri)
 *  ❌ Sentrert hero med padding-symmetri
 */
import Image from "next/image";
import Link from "next/link";

interface IndustrialHeroProps {
  kicker?: string;             // "CONTAINER CONSULT AS" — uppercase, mono, gul
  headline: string;            // Stort, uppercase, font-black
  subline?: string;
  ctaText: string;
  ctaUrl: string;
  bgImage: string;             // Tungt foto (lastebil/maskin/container)
  bgAlt: string;
}

export function IndustrialHero({
  kicker,
  headline,
  subline,
  ctaText,
  ctaUrl,
  bgImage,
  bgAlt,
}: IndustrialHeroProps) {
  return (
    <section className="relative isolate min-h-[80vh] overflow-hidden bg-secondary text-white">
      {/* Full-opacity bilde (bildet er ankeret, ikke bakgrunnen) */}
      <Image
        src={bgImage}
        alt={bgAlt}
        fill
        priority
        fetchPriority="high"
        sizes="100vw"
        className="-z-10 object-cover"
      />

      {/* Vignett VENSTRE — tekstområde leselig, høyre del fri */}
      <div
        className="absolute inset-0 -z-10 bg-gradient-to-r from-black/85 via-black/50 to-transparent"
        aria-hidden
      />
      {/* Subtil bunn-fade for footer-tekst-area */}
      <div
        className="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-black/70 to-transparent"
        aria-hidden
      />

      <div className="mx-auto flex min-h-[80vh] max-w-6xl flex-col justify-end px-6 py-20 md:py-28">
        {/* Gul accent-strek over kicker — Industrial signal */}
        <div className="mb-4 h-1 w-16 bg-primary" aria-hidden />

        {kicker && (
          <p className="font-mono text-xs uppercase tracking-[0.3em] text-primary">{kicker}</p>
        )}

        {/* Tung kondensert display-font, uppercase, MASSIV skala */}
        <h1 className="mt-4 max-w-5xl font-display text-5xl font-black uppercase leading-[0.95] tracking-tight md:text-7xl lg:text-8xl">
          {headline}
        </h1>

        {subline && (
          <p className="mt-6 max-w-2xl text-lg text-zinc-200 md:text-xl">{subline}</p>
        )}

        <div className="mt-10">
          {/* Hard-shadow CTA UTEN rounding — Industrial-signal */}
          <Link
            href={ctaUrl}
            className="
              inline-flex items-center gap-2 bg-primary px-8 py-4
              font-display text-lg font-bold uppercase tracking-wider text-secondary
              shadow-[8px_8px_0_rgba(0,0,0,0.4)]
              transition-all duration-200
              hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[12px_12px_0_rgba(0,0,0,0.5)]
              active:translate-x-0 active:translate-y-0 active:shadow-[4px_4px_0_rgba(0,0,0,0.4)]
            "
          >
            {ctaText} →
          </Link>
        </div>
      </div>

      {/* Optional: industri-stripe (gul/sort sikkerhetsstriper) i bunn av seksjon */}
      <div className="absolute inset-x-0 bottom-0 h-2 industrial-stripe" aria-hidden />
    </section>
  );
}

/**
 * Bruk:
 *
 * <IndustrialHero
 *   kicker="CONTAINER CONSULT AS"
 *   headline="50 år i bransjen"
 *   subline="Avfallscontainere, lagercontainere, kraning, maskintransport og avfallshåndtering i Ålesund og omegn."
 *   ctaText="Bestill container"
 *   ctaUrl="/bestill"
 *   bgImage="/hero-scania-truck.jpg"
 *   bgAlt="Scania-lastebil med container på vei til byggeplass"
 * />
 */
