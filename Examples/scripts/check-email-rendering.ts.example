#!/usr/bin/env node
/**
 * Email Rendering Check — verifiserer at hver react-email-mal
 * rendrer uten feil og har required props.
 *
 * Kjør: pnpm tsx scripts/check-email-rendering.ts
 */

import { render } from '@react-email/render'
import { glob } from 'glob'
import path from 'node:path'
import { writeFile, mkdir } from 'node:fs/promises'

interface TemplateCheck {
  file: string
  rendered: boolean
  hasFooterCredit: boolean
  htmlLength: number
  error: string | null
  passed: boolean
}

const FOOTER_RE = /Utviklet av Myrvoll-Lunde IT Drift/i
const FT_LINK_RE = /mlit.no/i

async function checkTemplate(file: string): Promise<TemplateCheck> {
  try {
    const mod = await import(path.resolve(file))
    const Component = mod.default
    if (!Component) {
      return {
        file,
        rendered: false,
        hasFooterCredit: false,
        htmlLength: 0,
        error: 'No default export',
        passed: false,
      }
    }

    const props = mod.previewProps ?? {}
    const html = await render(Component(props))

    const hasFooterCredit = FOOTER_RE.test(html) && FT_LINK_RE.test(html)

    return {
      file,
      rendered: true,
      hasFooterCredit,
      htmlLength: html.length,
      error: null,
      passed: hasFooterCredit && html.length > 500,
    }
  } catch (e) {
    return {
      file,
      rendered: false,
      hasFooterCredit: false,
      htmlLength: 0,
      error: e instanceof Error ? e.message : String(e),
      passed: false,
    }
  }
}

async function main(): Promise<void> {
  const files = await glob('emails/**/*.tsx', { ignore: ['emails/**/_*'] })

  if (files.length === 0) {
    console.error('✗ Ingen email-templates funnet i emails/')
    process.exit(1)
  }

  const results: TemplateCheck[] = []
  for (const file of files) {
    results.push(await checkTemplate(file))
  }

  const failed = results.filter((r) => !r.passed)

  const report = {
    timestamp: new Date().toISOString(),
    total: results.length,
    failed: failed.length,
    results,
    passed: failed.length === 0,
  }

  const outDir = path.join(process.cwd(), 'reports')
  await mkdir(outDir, { recursive: true })
  await writeFile(path.join(outDir, 'email-rendering.json'), JSON.stringify(report, null, 2))

  if (failed.length === 0) {
    console.log(`✓ Email-rendering OK — ${results.length}/${results.length} maler rendrer + har footer-credit`)
    return
  }

  console.error(`✗ Email-rendering FAILED — ${failed.length} maler feiler`)
  for (const r of failed) {
    console.error(`  ${r.file}`)
    if (r.error) console.error(`    Error: ${r.error}`)
    if (!r.hasFooterCredit) console.error(`    Mangler footer-credit til mlit.no`)
    if (r.htmlLength < 500) console.error(`    Suspiciously short HTML (${r.htmlLength} bytes)`)
  }
  process.exit(1)
}

main().catch((e) => {
  console.error('check-email-rendering crashed:', e)
  process.exit(2)
})
